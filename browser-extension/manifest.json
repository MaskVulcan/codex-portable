{
  "manifest_version": 3,
  "name": "Codex Portable 浏览器采集助手",
  "version": "1.3.0",
  "description": "连接本机便携助手，复用已登录的 Chrome/Edge 标签页进行浏览、收集和截图。",
  "permissions": ["debugger", "tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"
  },
  "background": { "service_worker": "worker.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "连接 Codex Portable"
  }
}
